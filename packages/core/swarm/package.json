{
  "name": "@swarmx/dsh-swarm",
  "version": "0.1.0",
  "description": "Durable DSH-native agent swarms for SwarmX.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./contracts": {
      "types": "./lib/types/contracts.d.ts",
      "default": "./lib/contracts.js"
    },
    "./remote": {
      "types": "./lib/types/remote.d.ts",
      "default": "./lib/remote.js"
    },
    "./remote-contract": {
      "types": "./lib/types/remote-contract.d.ts",
      "default": "./lib/remote-contract.js"
    },
    "./tools": {
      "types": "./lib/types/tools.d.ts",
      "default": "./lib/tools.js"
    },
    "./typert": {
      "types": "./lib/types/typert.d.ts",
      "default": "./lib/typert.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "test": "vitest run --root ../../.. packages/core/swarm/tests"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-llm": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-session": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-subagent": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-tools": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-typert-protocol": "0.1.2-alpha.4",
    "@deepseek-ai/schemastery": "^3.18.2",
    "zod": "^4.4.3"
  },
  "files": [
    "lib/index.js",
    "lib/contracts.js",
    "lib/errors.js",
    "lib/remote.js",
    "lib/remote-contract.js",
    "lib/tools.js",
    "lib/typert.js",
    "lib/types/**/*.d.ts",
    "config/agent-presets",
    "src",
    "cordis.patch.yml"
  ]
}
