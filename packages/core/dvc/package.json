{
  "name": "@swarmx/dsh-dvc",
  "version": "0.1.0",
  "description": "Host-only DVC status, pull, and isolated reproduction service for SwarmX.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "test": "vitest run --root ../../.. packages/core/dvc/tests"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-subprocess": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-subprocess-local": "0.1.1-rc.2"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "src",
    "cordis.patch.yml"
  ]
}
