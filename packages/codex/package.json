{
  "name": "@swarmx/codex",
  "version": "4.0.0",
  "description": "Repository-owned Codex app-server harness plugin for SwarmX.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tcztzy/swarmx.git",
    "directory": "packages/codex"
  },
  "type": "module",
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": "./bin/swarmx-codex.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "swarmx-codex": "./bin/swarmx-codex.js"
  },
  "scripts": {
    "build": "tsc && node --check bin/swarmx-codex.js && node --check bin/swarmx-codex-container.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@openai/codex": "0.147.0",
    "@openai/codex-linux-arm64": "npm:@openai/codex@0.147.0-linux-arm64",
    "@openai/codex-linux-x64": "npm:@openai/codex@0.147.0-linux-x64"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
