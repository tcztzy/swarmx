{
  "name": "@swarmx/desktop",
  "version": "3.2.0",
  "description": "Electron desktop host and reusable renderer shell for SwarmX.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tcztzy/swarmx.git",
    "directory": "packages/desktop"
  },
  "type": "module",
  "main": "./out/main/index.js",
  "files": [
    "out",
    "dist/main",
    "dist/preload",
    "dist/renderer",
    "dist/shared",
    "build",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "third_party_licenses",
    "scripts/electron-stderr.mjs",
    "scripts/start-electron.mjs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./out/main/index.js",
    "./package.json": "./package.json",
    "./main": {
      "types": "./dist/main/library.d.ts",
      "import": "./out/main/library.js"
    },
    "./preload": {
      "types": "./dist/preload/api.d.ts",
      "import": "./dist/preload/api.js"
    },
    "./renderer": {
      "types": "./dist/renderer/App.d.ts",
      "import": "./dist/renderer/App.js"
    },
    "./styles.css": "./out/renderer/assets/swarmx.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.renderer-lib.json && tsc -p tsconfig.main-lib.json && tsc -p tsconfig.preload-lib.json",
    "build:mem-runtime": "node scripts/build-mem-runtime.mjs",
    "dist:mac": "pnpm build && node scripts/build-macos-artifacts.mjs",
    "preview": "vite preview",
    "start": "node scripts/start-electron.mjs",
    "test": "vitest run",
    "test:e2e:release": "vitest run src/main/direct-harness-release.e2e.test.ts",
    "test:smoke": "node scripts/test-desktop-smoke.mjs",
    "test:mem-runtime": "node scripts/test-mem-runtime.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@swarmx/core": "workspace:*",
    "@swarmx/runtime": "workspace:*",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "cron-parser": "5.6.2",
    "katex": "^0.18.1",
    "lucide-react": "^1.28.0",
    "node-pty": "^1.1.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^4.4.1",
    "swr": "^2.4.2",
    "vscode-jsonrpc": "9.0.1",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vite-plugin-electron": "^1.1.0"
  }
}
