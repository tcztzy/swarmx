{
  "name": "@swarmx/science",
  "version": "0.1.0",
  "description": "Local-first scientific journal and domain service for SwarmX.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/contracts.d.ts",
      "default": "./lib/contracts.js"
    },
    "./tools": {
      "types": "./lib/types/tools.d.ts",
      "default": "./lib/tools.js"
    },
    "./resource-id": {
      "types": "./lib/types/resource-id.d.ts",
      "default": "./lib/resource-id.js"
    },
    "./resource-resolver": {
      "types": "./lib/types/resource-resolver.d.ts",
      "default": "./lib/resource-resolver.js"
    },
    "./resource-view": {
      "types": "./lib/types/resource-view.d.ts",
      "default": "./lib/resource-view.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "bundle": "tsdown",
    "test": "vitest run"
  },
  "dependencies": {
    "@swarmx/annotation": "workspace:*",
    "@xmldom/xmldom": "0.9.12",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "papaparse": "^5.6.0",
    "pdf-lib": "1.17.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/papaparse": "^5.5.2"
  },
  "files": [
    "lib/index.js",
    "lib/contracts.js",
    "lib/tools.js",
    "lib/resource-id.js",
    "lib/resource-id2.js",
    "lib/resource-resolver.js",
    "lib/resource-view.js",
    "lib/types/**/*.d.ts",
    "bin",
    "src",
    "demo"
  ]
}
