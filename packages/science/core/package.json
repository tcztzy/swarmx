{
  "name": "@swarmx/dsh-science",
  "version": "0.1.0",
  "description": "Local-first scientific journal and domain service for SwarmX.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/contracts.d.ts",
      "default": "./lib/contracts.js"
    },
    "./typert": {
      "types": "./lib/types/typert.d.ts",
      "default": "./lib/typert.js"
    },
    "./remote": {
      "types": "./lib/types/remote.d.ts",
      "default": "./lib/remote.js"
    },
    "./tools": {
      "types": "./lib/types/tools.d.ts",
      "default": "./lib/tools.js"
    },
    "./preset": {
      "types": "./lib/types/preset.d.ts",
      "default": "./lib/preset.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "test": "vitest run"
  },
  "dependencies": {
    "@swarmx/annotation": "workspace:*",
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-attachment": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2",
    "@deepseek-ai/dsh-subprocess": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@xmldom/xmldom": "0.9.12",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "papaparse": "^5.6.0",
    "pdf-lib": "1.17.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-subprocess-local": "0.1.1-rc.2",
    "@types/papaparse": "^5.5.2"
  },
  "files": [
    "lib/index.js",
    "lib/contracts.js",
    "lib/typert.js",
    "lib/remote.js",
    "lib/remote-contract.js",
    "lib/tools.js",
    "lib/preset.js",
    "lib/types/**/*.d.ts",
    "bin",
    "src",
    "demo",
    "config/agent-presets",
    "cordis.patch.yml"
  ]
}
