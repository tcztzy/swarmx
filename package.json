{
  "name": "swarmx-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "workspaces": [
    "packages/*/*",
    "apps/*"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "pnpm clean && pnpm build:lib && pnpm build:renderer && pnpm build:desktop",
    "build:lib": "pnpm build:writing-preview-runtime && tsc -b packages/core/annotation packages/core/dvc packages/core/memory packages/core/swarm packages/science/core && pnpm --filter './packages/**' -r bundle",
    "build:writing-preview-runtime": "tsx scripts/build-writing-preview-runtime.ts",
    "build:renderer": "vite build --config apps/desktop/vite.config.ts",
    "build:desktop": "tsc -b apps/desktop",
    "acp": "node apps/desktop/dist/acp-main.js",
    "clean": "tsx scripts/clean.ts",
    "dev": "pnpm build:writing-preview-runtime && tsx watch --clear-screen=false --include './apps/desktop/src/**' --include './packages/**/src/**' --exclude './apps/desktop/src/renderer/**' scripts/dev.ts",
    "web": "pnpm build && node apps/desktop/dist/web-main.js",
    "docs:check": "node scripts/check-codebase-docs.mjs",
    "lint": "biome check .",
    "paper:demo": "node examples/softwarex/swarm-memory/scripts/verify.mjs",
    "test": "pnpm build:lib && vitest run",
    "start": "pnpm build && pnpm --filter @swarmx/desktop start:built",
    "typecheck": "tsc -b tsconfig.host.json && tsc -p apps/desktop/tsconfig.renderer.json --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.0",
    "jsdom": "^30.0.1",
    "lightningcss": "^1.32.0",
    "tsdown": "^0.22.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.8"
  }
}
