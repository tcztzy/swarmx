{
  "name": "swarmx-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "workspaces": [
    "packages/*/*",
    "apps/*"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "pnpm clean && pnpm build:lib && pnpm build:renderer && pnpm build:desktop",
    "build:lib": "pnpm build:writing-preview-runtime && tsc -b packages/core/annotation packages/core/dvc packages/core/knowledge-base packages/core/swarm packages/science/core && pnpm --filter './packages/**' -r bundle",
    "build:writing-preview-runtime": "tsx scripts/build-writing-preview-runtime.ts",
    "build:renderer": "vite build --config apps/desktop/vite.config.ts",
    "build:desktop": "pnpm agents:types && tsc -b apps/desktop",
    "acp": "node apps/desktop/dist/acp-main.js",
    "agents:types": "node scripts/generate-agent-types.mjs",
    "clean": "tsx scripts/clean.ts",
    "dev": "pnpm start",
    "docs:check": "node scripts/check-codebase-docs.mjs",
    "lint": "biome check .",
    "test": "pnpm build:lib && vitest run",
    "start": "pnpm build && pnpm --filter @swarmx/desktop start:built",
    "typecheck": "pnpm agents:types && tsc -b tsconfig.host.json && tsc -p apps/desktop/tsconfig.renderer.json --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@types/node": "^22.20.0",
    "lightningcss": "^1.32.0",
    "tsdown": "^0.22.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.8"
  }
}
